Algoritmo Registro_Pasajeros
    Definir pasajeros, capacidad Como Entero
    pasajeros <- 0
    capacidad <- 10
    Escribir "Bienvenido a la ruta"
    Escribir "Capacidad maxima: ", capacidad
    Mientras pasajeros < capacidad Hacer
		
        Escribir "Sube un pasajero"
        pasajeros <- pasajeros + 1
		
        Escribir "Pasajeros actuales: ", pasajeros
		
    FinMientras
    Escribir "El vehiculo ha alcanzado su capacidad maxima"
    Escribir "Total de pasajeros: ", pasajeros
	
FinAlgoritmo


